# Required: generate with: openssl rand -hex 32
# Do not commit your real .env file or share this token in chat.
AUTH_TOKEN=

# Pin to a reviewed upstream release; change deliberately when updating.
XHS_IMAGE=xpzouying/xiaohongshu-mcp:v2.7.4

# Host loopback port. Keep the service bound to 127.0.0.1.
XHS_MCP_PORT=18060

# Persistent host directories (relative to this folder by default).
XHS_DATA_DIR=./data
XHS_MEDIA_DIR=./images

# Optional outbound proxy for requests to Xiaohongshu.
# Example: http://user:password@proxy.example:8080
XHS_PROXY=

# Docker network created for this MCP service.
# If cloudflared runs in Docker, connect its container to this network.
XHS_DOCKER_NETWORK=xiaohongshu-mcp-net
